# =========================
# CodePilot AI env example
# Copy this file to .env and fill your real secrets locally.
# Do NOT commit .env.
# =========================

# Internal REST API auth
CODEPILOT_API_AUTH_ENABLED=true
CODEPILOT_API_AUTH_API_KEY=change-me-local-dev-key
CODEPILOT_API_AUTH_HEADER_NAME=X-CodePilot-Api-Key
CODEPILOT_API_AUTH_PROTECTED_PATH_PATTERNS=/api/**
CODEPILOT_API_AUTH_EXCLUDE_PATH_PATTERNS=/api/github/webhook,/api/github/webhook/**

# Internal REST API fixed-window rate limit
CODEPILOT_API_RATE_LIMIT_ENABLED=true
CODEPILOT_API_RATE_LIMIT_MAX_REQUESTS_PER_WINDOW=60
CODEPILOT_API_RATE_LIMIT_WINDOW=60s
CODEPILOT_API_RATE_LIMIT_PROTECTED_PATH_PATTERNS=/api/**
CODEPILOT_API_RATE_LIMIT_EXCLUDE_PATH_PATTERNS=

# Background jobs
CODEPILOT_SCHEDULING_ENABLED=true

# GitHub API
# Auth mode: auto uses GitHub App when configured, otherwise PAT.
CODEPILOT_GITHUB_AUTH_MODE=auto
CODEPILOT_GITHUB_TOKEN=
CODEPILOT_GITHUB_APP_ID=
CODEPILOT_GITHUB_APP_PRIVATE_KEY=
CODEPILOT_GITHUB_APP_PRIVATE_KEY_BASE64=
CODEPILOT_GITHUB_APP_INSTALLATION_ID=
CODEPILOT_GITHUB_APP_TOKEN_CACHE_SKEW_SECONDS=60
CODEPILOT_GITHUB_COMMENT_ENABLED=false
CODEPILOT_GITHUB_COMMENT_MARKER=<!-- codepilot-ai-review:liche719/codeAireview -->
CODEPILOT_GITHUB_COMMENT_IDENTITY_HEADER_LINES=5
CODEPILOT_GITHUB_INLINE_COMMENT_ENABLED=false
CODEPILOT_GITHUB_INLINE_COMMENT_MAX_PER_TASK=10
CODEPILOT_GITHUB_BOT_MENTION_ALIASES=@x-pilotx,@X-PilotX
CODEPILOT_GITHUB_ALLOWED_REPOSITORIES=
CODEPILOT_GITHUB_RATE_LIMIT_MAX_ATTEMPTS=3
CODEPILOT_GITHUB_RATE_LIMIT_INITIAL_DELAY_MILLIS=1000
CODEPILOT_GITHUB_RATE_LIMIT_BACKOFF_MULTIPLIER=2.0
CODEPILOT_GITHUB_RATE_LIMIT_MAX_DELAY_MILLIS=10000
CODEPILOT_GITHUB_CONNECT_TIMEOUT=5s
CODEPILOT_GITHUB_READ_TIMEOUT=30s
CODEPILOT_GITHUB_CALL_TIMEOUT=45s
CODEPILOT_GITHUB_ALLOWED_COMMENT_AUTHOR_ASSOCIATIONS=OWNER,MEMBER,COLLABORATOR
CODEPILOT_GITHUB_FIX_ENABLED=false
CODEPILOT_GITHUB_FIX_PUBLISH_ENABLED=false
CODEPILOT_GITHUB_FIX_MERGE_ENABLED=false
CODEPILOT_GITHUB_FIX_APPROVAL_REQUIRE_SAME_USER=true
CODEPILOT_GITHUB_FIX_MAX_PATCH_CHARS=100000
CODEPILOT_GITHUB_FIX_BRANCH_PREFIX=codepilot/fix-
CODEPILOT_GITHUB_FIX_MERGE_METHOD=squash
CODEPILOT_GITHUB_FIX_MAX_FILES=3
CODEPILOT_GITHUB_FIX_MAX_CHANGED_LINES=120
CODEPILOT_GITHUB_FIX_VALIDATION_COMMAND=git diff --check
CODEPILOT_GITHUB_FIX_ALLOWED_VALIDATION_COMMANDS=git diff --check
CODEPILOT_GITHUB_FIX_VALIDATION_ALLOW_BUILD_COMMANDS=false
CODEPILOT_GITHUB_FIX_VALIDATION_INHERIT_ENVIRONMENT=false
CODEPILOT_GITHUB_FIX_VALIDATION_TIMEOUT_SECONDS=300
CODEPILOT_GITHUB_FIX_VALIDATION_EXECUTION_MODE=local
CODEPILOT_GITHUB_FIX_VALIDATION_DOCKER_IMAGE=
CODEPILOT_GITHUB_FIX_VALIDATION_DOCKER_NETWORK=none

# Command task reliability
CODEPILOT_COMMAND_EXECUTION_LEASE=15m
CODEPILOT_COMMAND_OUTBOX_BATCH_SIZE=20
CODEPILOT_COMMAND_OUTBOX_LOCK_TIMEOUT=2m
CODEPILOT_COMMAND_OUTBOX_CONFIRM_TIMEOUT=5s
CODEPILOT_COMMAND_OUTBOX_RETRY_INITIAL_DELAY=1s
CODEPILOT_COMMAND_OUTBOX_RETRY_MAX_DELAY=1m
CODEPILOT_COMMAND_OUTBOX_MAX_ATTEMPTS=10
CODEPILOT_COMMAND_RECOVERY_BATCH_SIZE=50

# Dead letter queue operations
CODEPILOT_DLQ_CONSUMER_ENABLED=true
CODEPILOT_DLQ_REPLAY_ENABLED=false
CODEPILOT_DLQ_RETENTION_DAYS=30
CODEPILOT_DLQ_PAYLOAD_MAX_CHARS=4000
CODEPILOT_DLQ_MAINTENANCE_INTERVAL_MILLIS=30000

# Resumable Agent runtime
CODEPILOT_AGENT_RESUMABLE_ENABLED=true
CODEPILOT_AGENT_MAX_MODEL_TURNS=8
CODEPILOT_AGENT_MAX_TOOL_CALLS=12
CODEPILOT_AGENT_MAX_CONTINUATIONS=4
CODEPILOT_AGENT_RUN_DEADLINE=30m
CODEPILOT_AGENT_CONTINUATION_CONTEXT_MAX_CHARS=4000
CODEPILOT_AGENT_WAITING_POLL_BATCH_SIZE=50
CODEPILOT_AGENT_CONVERSATION_MAX_TURNS=5
CODEPILOT_AGENT_CONVERSATION_MAX_CHARS=6000

# GitHub Webhook
CODEPILOT_GITHUB_WEBHOOK_ENABLED=false
CODEPILOT_GITHUB_WEBHOOK_SECRET=
CODEPILOT_GITHUB_WEBHOOK_SKIP_SIGNATURE_WHEN_SECRET_EMPTY=false

# LLM
CODEPILOT_LLM_API_KEY=
CODEPILOT_LLM_BASE_URL=https://api.openai.com/v1
CODEPILOT_LLM_MODEL=gpt-4o-mini
CODEPILOT_LLM_MAX_REVIEW_PATCH_CHARS=12000
CODEPILOT_LLM_MAX_REVIEW_RULES_CHARS=4000
CODEPILOT_LLM_MAX_REVIEW_CONTEXT_CHARS=8000
CODEPILOT_LLM_REVIEW_STRUCTURED_OUTPUT_ENABLED=true
CODEPILOT_LLM_REVIEW_CACHE_ENABLED=true
CODEPILOT_LLM_REVIEW_CACHE_TTL_DAYS=7
CODEPILOT_LLM_REVIEW_CACHE_CLEANUP_ENABLED=true
CODEPILOT_LLM_REVIEW_CACHE_CLEANUP_CRON=0 0 */6 * * *
CODEPILOT_LLM_CALL_LOG_CLEANUP_ENABLED=true
CODEPILOT_LLM_CALL_LOG_RETENTION_DAYS=30
CODEPILOT_LLM_CALL_LOG_CLEANUP_CRON=0 30 */6 * * *

# Embedding
CODEPILOT_EMBEDDING_API_KEY=
CODEPILOT_EMBEDDING_BASE_URL=https://api.openai.com/v1
CODEPILOT_EMBEDDING_MODEL=text-embedding-3-small
CODEPILOT_EMBEDDING_DIMENSION=0

# RAG cache
CODEPILOT_RAG_CACHE_ENABLED=true
CODEPILOT_RAG_CACHE_MAX_SIZE=256
CODEPILOT_RAG_CACHE_TTL_SECONDS=300

# SearXNG web search tool (disabled by default)
CODEPILOT_SEARXNG_ENABLED=false
CODEPILOT_SEARXNG_BASE_URL=
CODEPILOT_SEARXNG_TIMEOUT=5s
CODEPILOT_SEARXNG_MAX_RESULTS=5
CODEPILOT_SEARXNG_MAX_QUERY_CHARS=240
CODEPILOT_SEARXNG_MAX_RESULT_CHARS=1200
CODEPILOT_SEARXNG_ALLOWED_DOMAINS=
CODEPILOT_SEARXNG_DOCUMENT_FETCH_ENABLED=false
CODEPILOT_SEARXNG_DOCUMENT_FETCH_TIMEOUT=8s
CODEPILOT_SEARXNG_DOCUMENT_FETCH_MAX_BYTES=262144
CODEPILOT_SEARXNG_DOCUMENT_FETCH_MAX_CHARS=12000

# Review Limits
CODEPILOT_REVIEW_MAX_FILES_PER_TASK=30
CODEPILOT_REVIEW_MAX_SUMMARY_FINDINGS=20
CODEPILOT_REVIEW_COVERAGE_REPORT_ENABLED=true
CODEPILOT_REVIEW_COVERAGE_MAX_LISTED_FILES=20
CODEPILOT_REVIEW_MIN_COVERAGE_RATIO=0.5
# Cross-head-SHA finding memory (avoid re-commenting the same finding on every push)
CODEPILOT_REVIEW_FINDING_MEMORY_ENABLED=false
CODEPILOT_REVIEW_SUPPRESS_REPEATED_FINDINGS=true
CODEPILOT_REVIEW_ALLOW_RESOLUTION=true
# False-positive suppression: treat resolved review threads opened by the bot as "do not raise again"
CODEPILOT_REVIEW_DISMISSAL_SYNC_ENABLED=false
CODEPILOT_REVIEW_MAX_PATCH_CHARS_PER_FILE=12000
CODEPILOT_REVIEW_MAX_TOTAL_PATCH_CHARS=80000
CODEPILOT_REVIEW_MAX_PARALLEL_FILES=2
CODEPILOT_REVIEW_MAX_REPO_CONTEXT_FILES=6
CODEPILOT_REVIEW_MAX_REPO_CONTEXT_FILE_CHARS=20000
CODEPILOT_REVIEW_MAX_REPO_CONTEXT_EXCERPT_CHARS=900
CODEPILOT_REVIEW_EXECUTION_LEASE=15m
CODEPILOT_REVIEW_OUTBOX_BATCH_SIZE=20
CODEPILOT_REVIEW_OUTBOX_LOCK_TIMEOUT=2m
CODEPILOT_REVIEW_OUTBOX_CONFIRM_TIMEOUT=5s
CODEPILOT_REVIEW_OUTBOX_RETRY_INITIAL_DELAY=1s
CODEPILOT_REVIEW_OUTBOX_RETRY_MAX_DELAY=1m
CODEPILOT_REVIEW_OUTBOX_MAX_ATTEMPTS=10
CODEPILOT_REVIEW_PUBLICATION_MAX_ATTEMPTS=5
CODEPILOT_REVIEW_OUTBOX_POLL_INTERVAL_MILLIS=1000
CODEPILOT_REVIEW_EXECUTION_RECOVERY_INTERVAL_MILLIS=30000
CODEPILOT_REVIEW_PUBLICATION_POLL_INTERVAL_MILLIS=5000

# PostgreSQL
CODEPILOT_DB_NAME=codepilot
CODEPILOT_DB_URL=jdbc:postgresql://localhost:15432/codepilot
CODEPILOT_DB_USERNAME=codepilot
CODEPILOT_DB_PASSWORD=codepilot123

# Redis
CODEPILOT_REDIS_HOST=localhost
CODEPILOT_REDIS_PORT=16379
CODEPILOT_REDIS_DATABASE=0
CODEPILOT_REDIS_TIMEOUT=3s

# RabbitMQ
CODEPILOT_RABBITMQ_HOST=localhost
CODEPILOT_RABBITMQ_PORT=5672
CODEPILOT_RABBITMQ_USERNAME=codepilot
CODEPILOT_RABBITMQ_PASSWORD=codepilot123
CODEPILOT_RABBITMQ_VIRTUAL_HOST=/
CODEPILOT_RABBITMQ_DEFAULT_REQUEUE_REJECTED=false
CODEPILOT_RABBITMQ_LISTENER_CONCURRENCY=2
CODEPILOT_RABBITMQ_LISTENER_MAX_CONCURRENCY=4
CODEPILOT_RABBITMQ_LISTENER_PREFETCH=1
